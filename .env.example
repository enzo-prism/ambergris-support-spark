# Formspree form id for the Belize Kids homepage contact form.
# Create a form at https://formspree.io (no client email belongs in this repo),
# then set this on the Vercel project `belize-kids` for Production and Preview.
# Accepts the form hash (for example xyzabcd) or the full https://formspree.io/f/... URL.
VITE_FORMSPREE_CONTACT_ID=

# Formspree form id for the Belize Kids monthly-investment membership form.
# Same setup as above.
VITE_FORMSPREE_MEMBERSHIP_ID=
